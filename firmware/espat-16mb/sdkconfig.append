# Repository-owned overrides applied after ESP32-C6 defaults.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_AT_MQTT_COMMAND_SUPPORT=n
CONFIG_AT_HTTP_COMMAND_SUPPORT=n
CONFIG_BT_ENABLED=n
CONFIG_AT_BLE_COMMAND_SUPPORT=n
CONFIG_AT_BLUFI_COMMAND_SUPPORT=n
CONFIG_AT_OTA_COMMAND_SUPPORT=n
