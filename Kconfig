mainmenu "stm32l476-zephyr-mqtt"

config APP_USART1_LOOPBACK
	bool "Run bounded PA9-to-PA10 physical loopback verification"
	default n
	help
	  Requires PA9 to be physically connected to PA10. Results are logged on
	  the unchanged USART2/ST-LINK console. Do not enable for normal firmware.

config APP_ESPAT_AT_DIAGNOSTIC
	bool "Run bounded ESP-AT identity diagnostic on USART1"
	default y
	depends on !APP_USART1_LOOPBACK
	help
	  Sends AT followed by CRLF and requires final OK before sending AT+GMR
	  followed by CRLF. Each response uses a fixed 512-byte capture and a
	  bounded deadline, with results reported through USART2/ST-LINK.

source "Kconfig.zephyr"
